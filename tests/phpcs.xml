<?xml version="1.0"?>
<ruleset name="KCO Tests">
    <description>Test-suite style. WPCS does not apply under tests/; short arrays are required.</description>

    <arg name="extensions" value="php"/>

    <exclude-pattern>*/Support/_generated/*</exclude-pattern>
    <exclude-pattern>*/_wordpress/*</exclude-pattern>
    <exclude-pattern>*/_plugins/*</exclude-pattern>
    <exclude-pattern>*/_themes/*</exclude-pattern>
    <exclude-pattern>*/_output/*</exclude-pattern>

    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
</ruleset>
