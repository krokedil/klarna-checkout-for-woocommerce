# Kustom (Klarna) test credentials for the WP Playground dev environment.
# Preferred: put the values in the central ~/.config/krokedil-playground/.env
# (shared by every plugin checkout/worktree; stub the names with
# `npm exec krokedil-playground credentials`). Copying this file to a gitignored
# .env here works too and overrides the central file per repo.
# Values come from the Kustom/Klarna merchant portal, test environment (EU).
KCO_TEST_MERCHANT_ID_EU=
KCO_TEST_SHARED_SECRET_EU=
